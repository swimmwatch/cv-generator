{# ====== Compact "Order Opened" (parse_mode=HTML) ====== #}
{% set qp=qty_prec|default(4) %}{% set pp=price_prec|default(2) %}{% set mp=money_prec|default(2) %}
{% set qty=orig_qty|default(0.0) %}{% set px=price|default(0.0) %}
{% set notional=(qty * px) %}
{% set side=(position_side|default(side)|upper) %}
{% set side_e='🟢 LONG' if side=='LONG' else ('🔴 SHORT' if side=='SHORT' else side) %}

<b>🆕 {{ symbol }}</b> <i>{{ side_e }}{% if leverage %} • {{ leverage }}x{% endif %}{% if margin_mode %} • {{ margin_mode|capitalize }}{% endif %}</i> <br>
<b>Status:</b> NEW{% if order_type %} • <i>{{ order_type }}</i>{% endif %}{% if reduce_only is defined %} • RO={{ 'true' if reduce_only else 'false' }}{% endif %} <br>
<b>Qty:</b> {{ qty|round(qp) }} {{ base_asset }} @ {{ px|round(pp) }} {{ quote_asset }} <br>
<b>Notional:</b> {{ notional|round(pp) }} {{ quote_asset }} <br>
{% if initial_margin %}<b>Initial Margin:</b> {{ initial_margin|round(mp) }} {{ quote_asset }}{% endif %} <br>
{% if est_fee_quote is defined %}<b>Est. Fee:</b> {{ est_fee_quote|round(mp) }} {{ quote_asset }}{% endif %} <br>
<code>ID: {{ order_id }}</code>{% if client_order_id %} • <code>{{ client_order_id }}</code>{% endif %}{% if event_time_str %} • {{ event_time_str }}{% endif %} <br>