ENV=local
PYTHON_VERSION=3.13
POETRY_VERSION=2.2.1

IMAGE_APP=${COMPOSE_PROJECT_NAME}-app

DB_NAME=data
DB_HOST=localhost
DB_PORT=5115
DB_USER=bot
DB_PASSWORD=mypass

POSTGRES_DB=$DB_NAME
POSTGRES_USER=$DB_USER
POSTGRES_PASSWORD=$DB_PASSWORD
POSTGRES_PUBLIC_PORT=5115

REDIS_HOST=localhost
REDIS_PORT=6480
REDIS_PUBLIC_PORT=6480

WORKER_BROKER_URL=redis://localhost:6480/1
WORKER_RESULT_BACKEND=redis://localhost:6480/2

MINIO_URL=localhost:9339
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=super-secret-password
MINIO_ACCESS_KEY=$MINIO_ROOT_USER
MINIO_SECRET_KEY=$MINIO_ROOT_PASSWORD
MINIO_PUBLIC_PORT=9339
MINIO_PUBLIC_UI_PORT=9338

ADMIN_SESSION_SECRET=super-secret-session

WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50051
WEAVIATE_PUBLIC_HTTP_PORT=8081
WEAVIATE_PUBLIC_GRPC_PORT=50051

LOGGER_LEVEL=DEBUG

MCP_PROXY_BASE_URL=http://localhost:9090
MCP_PROXY_AUTH_TOKEN=change-me-secret-token
MCP_PROXY_PUBLIC_PORT=9090

FIRECRAWL_API_KEY=fc-your-api-key-here

AGENTS_MCP_PROXY_URL=http://localhost:9090
AGENTS_MCP_PROXY_AUTH_TOKEN=change-me-secret-token
AGENTS_MODEL_NAME=gpt-4o-mini
AGENTS_MODEL_TOKEN=your-openai-api-key

LOGFIRE_TOKEN=your-logfire-write-token
LOGFIRE_ENVIRONMENT=local
LOGFIRE_SERVICE_NAME=local-cv-generator
LOGFIRE_SEND_TO_LOGFIRE=false